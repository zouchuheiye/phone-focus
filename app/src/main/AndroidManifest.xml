<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-feature android:name="android.software.device_admin" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
    </queries>
    <application android:label="去做正事" android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme" android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="false" android:supportsRtl="true">
        <activity android:name=".ScheduleSetupActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="false" />
        <service android:name=".ScheduleAccessibilityService" android:exported="true"
            android:label="去做正事 · 每日时段" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/schedule_accessibility" />
        </service>
        <receiver android:name=".ScheduleAlarmReceiver" android:exported="false" android:directBootAware="true" />
        <activity android:name=".OwnerSetupActivity" android:exported="false" />
        <activity android:name=".FocusActivity" android:exported="false" android:launchMode="singleTask"
            android:excludeFromRecents="true" android:enableOnBackInvokedCallback="true" />
        <activity-alias android:name=".FocusHome" android:targetActivity=".FocusActivity" android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <service android:name=".ScreenMonitorService" android:exported="false"
            android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled local digital wellbeing screen monitor. After explicit force-lock device administrator consent, locks the phone after 180 seconds of continuous interactive screen time. Ongoing notification lets user stop. No data access or networking." />
        </service>
        <service android:name=".FocusService" android:exported="false" android:directBootAware="true"
            android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Explicitly started, device-owner-only timed focus session. Maintains a user-visible countdown and lock-task policies, restores saved policies at deadline or emergency recovery, and recovers after reboot. No networking or credential changes." />
        </service>
        <receiver android:name=".FocusAlarmReceiver" android:exported="false" android:directBootAware="true" />
        <receiver android:name=".RestoreReceiver" android:exported="true" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".LockAdminReceiver" android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:description="@string/lock_admin_description">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
